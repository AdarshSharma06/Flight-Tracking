# AI Service Configuration
# Copy to .env and fill in values

# Service
SERVICE_NAME=flight-tracking-ai-service
HOST=0.0.0.0
PORT=8001
ENVIRONMENT=development

# LLM Provider (abstracted - choose one: openai, ollama, openai-compatible, etc.)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# AI Service Authentication (shared secret with Spring Boot)
AI_SERVICE_API_KEY=

# Database
DATABASE_URL=

# Vector Database (pgvector on Supabase)
VECTOR_DATABASE_URL=

# Spring Boot Backend
SPRING_BOOT_BASE_URL=http://localhost:8080

# Observability
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173