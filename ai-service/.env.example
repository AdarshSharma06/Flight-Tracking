# AI Service Configuration
# Copy to .env and fill in values

# Service
SERVICE_NAME=flight-tracking-ai-service
HOST=0.0.0.0
PORT=8001
ENVIRONMENT=development

# LLM Provider (abstracted - choose one: openai, ollama, openai-compatible, etc.)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# AI Service Authentication (shared secret with Spring Boot)
AI_SERVICE_API_KEY=

# Database (PostgreSQL with pgvector)
DATABASE_URL=

# Spring Boot Backend — REQUIRED in production (Render)
# Canonical variable: SPRING_BOOT_BASE_URL
# Accepted aliases (for backwards compatibility): SPRING_BOOT_URL, BACKEND_URL, BACKEND_BASE_URL
# Local default: http://localhost:8080
# Production: set to deployed Spring Boot URL, e.g. https://your-backend.onrender.com
#            Do NOT hardcode the production URL in source code; configure via Render env vars.
# Tools (get_flight_status, get_airport_information, etc.) call Spring Boot via /api/ai/proxy/* using this URL.
SPRING_BOOT_BASE_URL=http://localhost:8080

# Observability
LOG_LEVEL=INFO
# Prompt versioning
PROMPT_VERSION=ai-10-v1
# Estimated cost per 1M tokens (USD) — leave empty if unavailable
LLM_INPUT_COST_PER_1M=
LLM_OUTPUT_COST_PER_1M=

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
