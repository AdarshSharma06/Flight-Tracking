# Frontend environment variables (Vite)
# Copy to .env.local or .env for local development

# Backend base URL (Spring Boot). Default is http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080

# Map: Leaflet + OpenStreetMap — no API key required.
# If you switch to Mapbox/MapTiler, add e.g.:
# VITE_MAPBOX_TOKEN=pk.your_public_token
# and tiles URL remains https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png by default.
# Component: src/components/tracking/TrackingMap.tsx

# 3D Aircraft: procedural model — no external asset required.
# To use a real GLB, place at public/models/aircraft.glb and update
# src/components/aircraft/AircraftViewer.tsx (see docs/API_MAPPING.md).
